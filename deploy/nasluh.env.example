# Переменные окружения НАСЛУХ.
# Копируется в /opt/nasluh/nasluh.env и правится там.
# Файл содержит секреты -- права 600, владелец root.

# --- обязательное ---
MIDI2TAB_DATA=/opt/nasluh/data
# Ключ подписи куки. Без него он генерируется заново при каждом
# перезапуске: у всех пользователей слетает счётчик бесплатных песен.
# Сгенерировать:  openssl rand -hex 32
MIDI2TAB_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ

# Ключ входа в админку. Без него страница /admin недоступна вообще.
MIDI2TAB_ADMIN_KEY=ЗАМЕНИТЕ_НА_ДРУГУЮ_СЛУЧАЙНУЮ_СТРОКУ

# Токен для автоматических проверок (GET /api/health, заголовок
# Authorization: Bearer <токен>). Отдельный от ключа админки намеренно:
# скрипту, который раз в несколько часов проверяет, жива ли оплата, не
# нужны права менять пользователей. Без него /api/health отвечает 503.
# Сгенерировать:  openssl rand -hex 32
# MIDI2TAB_HEALTH_TOKEN=

# --- пределы ---
MIDI2TAB_MAX_MB=60
# Должно быть не больше client_max_body_size в nginx, иначе nginx
# отрежет загрузку раньше, чем приложение успеет объяснить причину.

# --- уборка диска ---
NASLUH_KEEP_UPLOADS_DAYS=14
NASLUH_KEEP_STEMS_DAYS=14
NASLUH_LOW_DISK_RATIO=0.12

# --- оплата (заполняется, когда подключите магазин) ---
# PAYMENT_PROVIDER=getplatinum
# --- GetPlatinum, API версии 2 -------------------------------------------
PAYMENT_PROVIDER=getplatinum
GETPLATINUM_TERMINAL=153777

# Поддомен магазина -- тот, на котором открывается личный кабинет.
# Из него собирается адрес:
#   https://<магазин>.getplatinum.ru/api/public/v2/pay/init-payment-url
GETPLATINUM_SHOP=s-poryadok

# API-ключ из кабинета. Уходит заголовком Authorization: Bearer <ключ>
# и им же подписываются входящие уведомления.
# GETPLATINUM_SECRET_KEY=

# Адрес уведомлений, который надо указать в кабинете GetPlatinum:
#     https://naslux.ru/api/webhook/getplatinum
#
# Подпись уведомления настройки не требует: HMAC-SHA256 от тела запроса,
# ключ API, верхний регистр, заголовок X-Checksum -- всё по документации.

# ВНИМАНИЕ, НАЛОГОВОЕ. Эти два значения попадают в кассовый чек, и
# ошибка в них -- нарушение учёта, а не опечатка. Сверьте со своей
# заявкой на подключение организации.
#   ставка НДС: none -- не облагается (обычное для самозанятого),
#               иначе 0, 5, 7, 10, 22
GETPLATINUM_VAT=none
#   категория позиции в чеке: 3 -- Гайд (инструкция или методичка).
#   Это ближайшее к тому, что выдаёт сервис: разбор песни с аккордами
#   и табами. Полный список -- в спецификации GetPlatinum.
GETPLATINUM_PREFIX=3

