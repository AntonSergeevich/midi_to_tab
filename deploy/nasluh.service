[Unit]
Description=NASLUH - подбор песен на слух
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=nasluh
Group=nasluh
WorkingDirectory=/opt/nasluh/app
EnvironmentFile=/opt/nasluh/nasluh.env

# Ниже ProtectSystem=strict делает всю файловую систему доступной только
# для чтения, кроме папки данных. Библиотекам это ломает кэши, которые
# они по умолчанию пишут рядом со своими модулями: numba внутри librosa
# падает с "cannot cache function: no locator available". Поэтому все
# кэши явно перенаправляются в папку данных.
Environment=HOME=/opt/nasluh/data
Environment=XDG_CACHE_HOME=/opt/nasluh/data/cache
Environment=NUMBA_CACHE_DIR=/opt/nasluh/data/cache/numba
Environment=MPLCONFIGDIR=/opt/nasluh/data/cache/matplotlib

# Один рабочий процесс намеренно. Разбор идёт в пуле потоков внутри
# процесса, и каждый лишний процесс множит и пул, и память под PyTorch.
# На сервере с 4 ГБ два процесса кладут машину по памяти, а не ускоряют.
ExecStart=/opt/nasluh/venv/bin/uvicorn web.app:app \
    --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers \
    --forwarded-allow-ips='127.0.0.1'

Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

# Предел памяти: если разбор съест всё, systemd убьёт только сервис,
# а не даст ядру выбирать жертву по всему серверу.
MemoryMax=3G
MemoryHigh=2600M

# Ограничения доступа: сервису нужны только свои папки
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nasluh/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nasluh

[Install]
WantedBy=multi-user.target
