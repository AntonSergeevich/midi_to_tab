# Секрет вебхука автодеплоя.
# Копируется в /opt/nasluh/deploy-webhook.env, права 600, владелец root.
#
# Сознательно ОТДЕЛЬНЫЙ файл от nasluh.env: слушатель вебхука работает от
# root (см. nasluh-deploy-webhook.service), а веб-приложение -- нет и не
# должно видеть секрет, дающий права на деплой.

# Сгенерировать:  openssl rand -hex 32
DEPLOY_WEBHOOK_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ

# Тот же секрет указать в GitHub:
#   Settings -> Webhooks -> Add webhook
#     Payload URL:  https://naslux.ru/internal/deploy-webhook
#     Content type: application/json
#     Secret:       <это же значение>
#     Events:       Just the push event

# Ветка, пуш в которую разворачивается автоматически.
DEPLOY_WEBHOOK_BRANCH=claude/epic-mccarthy-sl30hz
