  async function hashEmailForOpenAI(email) {
    const cleanEmail = email.trim().toLowerCase();
    const encoder = new TextEncoder();
    const data = encoder.encode(cleanEmail);
    const hashBuffer = await crypto.subtle.digest('SHA-256', data);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
  }

  window.addEventListener('message', async function(event) {
    if (event.data.type === 'hsFormCallback' && 
       (event.data.eventName === 'onFormSubmit' || 
        event.data.eventName === 'onFormSubmitted')) {

      if (window['__oai_tracked_' + event.data.id]) return;
      window['__oai_tracked_' + event.data.id] = true;

      var submissionFields = event.data.data.submissionValues;
      var userEmail = submissionFields && submissionFields.email 
        ? submissionFields.email 
        : "";

      // Bing pixel
      window.uetq = window.uetq || [];
      if (userEmail) {
        window.uetq.push('set', { 'pid': { 'em': userEmail, 'ph': "" } });
      }
      window.uetq.push('event', 'submit_form', {});

      // OpenAI pixel
      try {
        if (typeof oaiq === "function") {
          if (userEmail) {
            const sha256Email = await hashEmailForOpenAI(userEmail);
            oaiq("measure", "lead_created", {
              email_sha256: sha256Email
            });
          } else {
            oaiq("measure", "lead_created");
          }
        }
      } catch (error) {
        console.error("OpenAI Conversion Tracking Error:", error);
      }
    }
  });
