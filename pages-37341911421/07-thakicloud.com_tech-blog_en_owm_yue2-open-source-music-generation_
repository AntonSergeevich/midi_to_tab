<!-- Mermaid diagram initialization (theme-aware: follows light/dark toggle) -->
<script>
  (function () {
    function mermaidTheme() {
      return document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'default';
    }
    function convert() {
      // Convert rouge ```mermaid code blocks into .mermaid divs once, caching source.
      document.querySelectorAll('pre code.language-mermaid, code.language-mermaid').forEach(function (element, index) {
        var code = element.textContent;
        var div = document.createElement('div');
        div.className = 'mermaid';
        div.setAttribute('data-src', code);
        div.textContent = code;
        div.id = 'mermaid-' + index;
        element.parentNode.replaceWith(div);
      });
    }
    function render() {
      if (typeof mermaid === 'undefined') return;
      mermaid.initialize({ startOnLoad: false, theme: mermaidTheme(), securityLevel: 'loose' });
      document.querySelectorAll('.mermaid').forEach(function (el) {
        el.removeAttribute('data-processed');
        var src = el.getAttribute('data-src'); // restore source (render replaces it with SVG)
        if (src) { el.innerHTML = src; }
      });
      try { mermaid.init(undefined, document.querySelectorAll('.mermaid')); }
      catch (e) { console.warn('mermaid render failed:', e); }
    }
    // Click-to-zoom lightbox for rendered Mermaid diagrams (GitHub-style:
    // click to open fullscreen, wheel/buttons to zoom, drag to pan, Esc to close).
    function setupMermaidZoom() {
      if (document.getElementById('mmd-lightbox')) return; // build once
      var lb = document.createElement('div');
      lb.id = 'mmd-lightbox';
      lb.className = 'mmd-lightbox';
      lb.setAttribute('hidden', '');
      lb.innerHTML =
        '<div class="mmd-lb-toolbar">' +
          '<button type="button" data-act="out" aria-label="Zoom out">−</button>' +
          '<button type="button" data-act="reset" aria-label="Reset zoom">↻</button>' +
          '<button type="button" data-act="in" aria-label="Zoom in">+</button>' +
          '<button type="button" data-act="close" aria-label="Close">✕</button>' +
        '</div>' +
        '<div class="mmd-lb-stage"><div class="mmd-lb-canvas"></div></div>';
      document.body.appendChild(lb);

      var canvas = lb.querySelector('.mmd-lb-canvas');
      var stage = lb.querySelector('.mmd-lb-stage');
      var scale = 1, tx = 0, ty = 0, dragging = false, sx = 0, sy = 0;

      function apply() { canvas.style.transform = 'translate(' + tx + 'px,' + ty + 'px) scale(' + scale + ')'; }
      function reset() { scale = 1; tx = 0; ty = 0; apply(); }
      function zoom(f) { scale = Math.min(8, Math.max(0.2, scale * f)); apply(); }
      function open(svg) {
        canvas.innerHTML = '';
        var clone = svg.cloneNode(true); // mermaid v10 inlines <style>, so colors survive
        // Mermaid SVGs carry width="100%"/small intrinsic sizing, so a plain clone
        // stays thumbnail-sized. Force an explicit fit-to-viewport size from the
        // viewBox aspect ratio so it opens large (then transform scale zooms further).
        var vb = (svg.getAttribute('viewBox') || '').split(/[\s,]+/).map(parseFloat);
        var r = svg.getBoundingClientRect();
        var iw = (vb.length === 4 && vb[2]) ? vb[2] : (parseFloat(svg.getAttribute('width')) || r.width || 800);
        var ih = (vb.length === 4 && vb[3]) ? vb[3] : (parseFloat(svg.getAttribute('height')) || r.height || 600);
        var aspect = iw / ih;
        var maxW = window.innerWidth * 0.92, maxH = window.innerHeight * 0.82;
        var w, h;
        if (maxW / maxH > aspect) { h = maxH; w = h * aspect; } else { w = maxW; h = w / aspect; }
        clone.removeAttribute('style');
        clone.setAttribute('width', w);
        clone.setAttribute('height', h);
        clone.style.width = w + 'px';
        clone.style.height = h + 'px';
        clone.style.maxWidth = 'none';
        clone.style.maxHeight = 'none';
        canvas.appendChild(clone);
        reset();
        lb.removeAttribute('hidden');
        document.body.style.overflow = 'hidden';
      }
      function close() { lb.setAttribute('hidden', ''); document.body.style.overflow = ''; canvas.innerHTML = ''; }

      lb.querySelector('.mmd-lb-toolbar').addEventListener('click', function (e) {
        var b = e.target.closest('button'); if (!b) return;
        e.stopPropagation();
        var a = b.getAttribute('data-act');
        if (a === 'in') zoom(1.25); else if (a === 'out') zoom(0.8);
        else if (a === 'reset') reset(); else if (a === 'close') close();
      });
      stage.addEventListener('wheel', function (e) { e.preventDefault(); zoom(e.deltaY < 0 ? 1.12 : 0.89); }, { passive: false });
      stage.addEventListener('pointerdown', function (e) { dragging = true; sx = e.clientX - tx; sy = e.clientY - ty; try { stage.setPointerCapture(e.pointerId); } catch (_) {} });
      stage.addEventListener('pointermove', function (e) { if (!dragging) return; tx = e.clientX - sx; ty = e.clientY - sy; apply(); });
      stage.addEventListener('pointerup', function () { dragging = false; });
      lb.addEventListener('click', function (e) { if (e.target === lb || e.target === stage) close(); });
      document.addEventListener('keydown', function (e) { if (!lb.hasAttribute('hidden') && e.key === 'Escape') close(); });

      // Delegated: click any rendered .mermaid diagram to open it zoomed.
      document.addEventListener('click', function (e) {
        var m = e.target.closest('.mermaid');
        if (!m || lb.contains(m)) return;
        var svg = m.querySelector('svg');
        if (svg) open(svg);
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      convert();
      render();
      setupMermaidZoom();
      // Re-render diagrams whenever the light/dark theme flips.
      new MutationObserver(function (muts) {
        muts.forEach(function (m) { if (m.attributeName === 'data-theme') render(); });
      }).observe(document.documentElement, { attributes: true });
    });
  })();
</script>

