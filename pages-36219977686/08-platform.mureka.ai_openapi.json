      // 监听屏幕方向变化
      window.addEventListener("orientationchange", function () {
        switch (window.screen.orientation?.type) {
          case "landscape-primary":
            console.log("横屏，设备顶部在正常位置");
            break;
          case "landscape-secondary":
            console.log("横屏，设备顶部被旋转到底部");
